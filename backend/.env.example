# CarbonX Backend Environment Configuration Template
PROJECT_NAME="CarbonX API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/carbonx
SYNC_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/carbonx

# JWT Security
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Application Environment
ENVIRONMENT=development
DEBUG=True
